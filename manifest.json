{
  "manifest_version": 3,
  "name": "YouTube · Vu-mètre",
  "version": "1.1.0",
  "description": "Niveaux audio stéréo des vidéos et lives YouTube, même lorsque le lecteur est en sourdine.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "action": {
    "default_title": "Afficher le vu-mètre YouTube"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/embed/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
